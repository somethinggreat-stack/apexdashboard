{
    "name": "Apex Team Chat",
    "short_name": "Team Chat",
    "description": "Apex Growth internal team chat.",
    "id": "/admin/team-messages",
    "start_url": "/admin/team-messages?standalone=1&source=pwa",
    "scope": "/admin/team-messages",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#f4f6fb",
    "theme_color": "#6366f1",
    "categories": ["business", "productivity"],
    "lang": "en",
    "dir": "ltr",
    "icons": [
        { "src": "/Images/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/Images/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/Images/pwa/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
        { "src": "/Images/pwa/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ]
}
